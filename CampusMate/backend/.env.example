PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/campusmate?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_of_32_plus_chars

# Only used by `npm run seed` (creates the first admin account)
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@12345

# Optional: comma separated list of frontend origins if you host the frontend elsewhere (e.g. GitHub Pages)
# CLIENT_ORIGIN=https://codewithparveen.github.io
